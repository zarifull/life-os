generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model profiles {
  id         String   @id @default(dbgenerated("auth.uid()"))
  username   String?
  full_name  String?
  avatar_url String?
  pin_code   String?
  updated_at DateTime @updatedAt

  @@map("profiles") // This matches the Supabase naming convention
}

model Plan {
  id          String   @id @default(cuid())
  title       String
  time        String
  target_date String
  completed   Boolean  @default(false)
  userId      String

}

model EnergyLog {
  id      String   @id @default(cuid())
  level   Int
  date    DateTime @default(now())
  userId  String

}

model Memory {
  id        String   @id @default(cuid())
  content   String
  category  String?
  createdAt DateTime @default(now())
  userId    String

}

model DailyBurn {
  id        String   @id @default(cuid())
  amount    Float
  category  String
  note      String?
  createdAt DateTime @default(now())

}

model WealthVault {
  id          String   @id @default(cuid())
  balance     Float    @default(0)
  lastUpdated DateTime @updatedAt
  autoSave    Boolean  @default(true)

}

model Transaction {
  id       String   @id @default(cuid())
  amount   Float
  type     String
  category String
  label    String
  date     DateTime @default(now())
  userId   String

}

model Vault {
  id        String   @id @default(cuid())
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt

}

model UserSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  autoVault    Boolean  @default(true)
  vaultBalance Int      @default(0)
  updatedAt    DateTime @updatedAt

}